# ~/.zshenv — zsh 每个进程都加载（含非登录 / 非交互）。
# 只放基础 env，保证从任意方式启动的 claude / opencode 都指向 MSYS2 home。
{{- if eq .chezmoi.os "windows" }}
# zsh 启动早期 PATH 可能尚未包含 MSYS2 的 /usr/bin（如从 Windows 直接拉起），
# 先补上，保证下面的 cygpath 可用。
case ":$PATH:" in *":/usr/bin:"*) ;; *) PATH="/usr/bin:$PATH" ;; esac
export XDG_CONFIG_HOME="$(cygpath -m "$HOME/.config" 2>/dev/null || echo "$HOME/.config")"
{{- if env "MSYSTEM" }}
# Claude Code 用 MSYS2 home 下的 .claude（而非 %USERPROFILE%\.claude）
export CLAUDE_CONFIG_DIR="$(cygpath -w "$HOME/.claude" 2>/dev/null || echo "$HOME/.claude")"
{{- end }}
{{- end }}
