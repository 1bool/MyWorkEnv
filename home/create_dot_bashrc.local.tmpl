# ~/.bashrc.local — bash 侧复用 ~/.zshrc.local 的公共 AI 配置（A/B 后端 baseURL/key）
# 本文件只放 bash 专用覆盖；被 source 的 ~/.zshrc.local 必须保持 bash/zsh 兼容语法
# （只使用 [[ ]] / export / $(...) / . 等两边都支持的语法，勿加 setopt/数组等 zsh 专有写法）。
[ -f ~/.zshrc.local ] && . ~/.zshrc.local

# bash 专用覆盖（示例，填真实值后取消注释）
# export TESTLINK_KEY=你的-testlink-key
