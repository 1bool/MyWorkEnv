#!/usr/bin/env bash
# Claude Code → MSYS2 shell wrapper
# MSYS2 root is read from CONFIG_SITE (set by MSYS2 parent process).
# ${CONFIG_SITE%/etc/config.site} → e.g. D:/Desktop/msys64

msys_root="${CONFIG_SITE%/etc/config.site}"

if [[ -z "$msys_root" || ! -x "$msys_root/usr/bin/bash.exe" ]]; then
    echo "ERROR: Cannot find MSYS2 bash. CONFIG_SITE='$CONFIG_SITE'" >&2
    exit 1
fi

exec "$msys_root/usr/bin/bash.exe" "$@"
