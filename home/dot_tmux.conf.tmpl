# screen 模式
#unbind ^b
#set -g prefix 'C-a'
#bind-key C-a send-prefix
# split panes using | and -
unbind '"'
unbind %
bind | split-window -h -c '#{pane_current_path}'
bind - split-window -v -c '#{pane_current_path}'
# Default terminal: tmux-256color is the most accurate (256 colors + correct key sequences)
set -g default-terminal "tmux-256color"
# Add truecolor support: Tc tells tmux the outer terminal supports 24-bit
set-option -ga terminal-overrides ",*256color:Tc"
# 把焦点变化事件转发给 pane 里的程序（nvim 的 FocusGained/FocusLost 依赖它）
set -g focus-events on
# set window and pane index to 1 (0 by default)
set-option -g base-index 1
setw -g pane-base-index 1
# start a non-login shell
set -g default-command "${SHELL}"
# reload ~/.tmux.conf using PREFIX r
bind r source-file ~/.tmux.conf \; display "Reloaded!"
# switch panes using Alt-jklh without prefix
bind -n M-h select-pane -L
bind -n M-l select-pane -R
bind -n M-k select-pane -U
bind -n M-j select-pane -D
# vi模式切换窗口
bind h previous-window
bind l next-window
# vi 风格 copy mode 和粘贴
unbind p
bind p paste-buffer
bind v copy-mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
# bind j select-pane -D
# bind k select-pane -U
# 给调整窗格大小设置快捷键
bind H resize-pane -L 8  # 向左扩展
bind L resize-pane -R 8  # 向右扩展
bind K resize-pane -U 4   # 向上扩展
bind J resize-pane -D 4   # 向下扩展
# 鼠标支持
setw -g mouse on
# copy mode 使用 vi 键位
setw -g mode-keys vi
# 旧版鼠标支持
# setw -g mode-mouse on
# set -g mouse-select-pane on
# set -g mouse-resize-pane on
# set -g mouse-select-window on
# 增加可上翻buffer容量
set-option -g history-limit 32768
# 关闭窗口后重新排序
set-option -g renumber-windows on
# tmux-plugin
set -g @plugin 'tmux-plugins/tpm'
# set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-cpu'

# Status bar theme: catppuccin（纯 shell，无 Python 依赖）
set -g @catppuccin_flavor 'mocha'  # latte / frappe / macchiato / mocha
# catppuccin 放 plugins-manual（不在 tpm @plugin 里），避免 tpm clean_plugins 误删
run '~/.tmux/plugins-manual/catppuccin/catppuccin.tmux'

{{- if ne .chezmoi.os "windows" }}
# load 模块插件把命令包在 l: 字面量里导致 #() 不执行、只显示原命令，这里覆盖成可执行版本
set -g @catppuccin_load_text "#(uptime | awk '{split(substr($0, index($0, \"load\")), a, \":\"); print a[2]}')"
# cpu/ram：tmux-cpu 的插值只扫 status-right/left 的字面量，扫不到 catppuccin 嵌套的 #{E:...}，
# 所以直接嵌脚本命令（tmux-cpu 同时提供 cpu 和 ram，无需单独的 tmux-ram 插件）
set -g @catppuccin_cpu_text " #(~/.tmux/plugins/tmux-cpu/scripts/cpu_percentage.sh)"
set -g @catppuccin_ram_text " #(~/.tmux/plugins/tmux-cpu/scripts/ram_percentage.sh)"
# gitmux：插件默认 -cfg 指向不存在的 ~/.gitmux.conf 会空输出，去掉 -cfg 用内置默认配置
# （gitmux 无 Windows 二进制，仅 Linux/macOS 启用）
set -g @catppuccin_gitmux_text ' #(gitmux "#{pane_current_path}")'
{{- end }}

# 状态栏模块
# Linux：左=会话+路径，右=git+cpu+内存+uptime+负载+时间（全量）
# Windows：不加 cpu/内存/uptime/负载；图标经 #() 成品字符串输出（避免 tmux 格式串的 PUA 慢路径）
set -g status-left-length 100
set -g status-right-length 200
{{- if ne .chezmoi.os "windows" }}
set -g status-left "#{E:@catppuccin_status_session}#{E:@catppuccin_status_directory}"
set -g status-right "#{E:@catppuccin_status_gitmux}#{E:@catppuccin_status_cpu}#{E:@catppuccin_status_ram}#{E:@catppuccin_status_uptime}#{E:@catppuccin_status_load}#{E:@catppuccin_status_date_time}"
{{- else }}
# Windows/MSYS2：PUA 图标走 #() 会闪烁、放格式串会丢输入，改用非 PUA 定宽 Unicode 装饰（»）。
# cpu/内存/负载/uptime 由 statusd.sh 驻留进程写入 @catppuccin_*_text（值含 %%），经 #{E:...}
# 二次展开还原成 %；无 #()、无 PUA 图标，状态栏刷新不 spawn、不丢输入。
run -b '~/.tmux/scripts/statusd.sh'
set -g status-left "#[fg=#{@thm_crust},bg=#{@thm_green}] » #{session_name} #[fg=#{@thm_crust},bg=#{@thm_rosewater}] » #{pane_current_path} #[fg=#{@thm_fg},bg=default]"
set -g status-right "#[fg=#{@thm_crust},bg=#{@thm_yellow}] »#{E:@catppuccin_cpu_text} #[fg=#{@thm_crust},bg=#{@thm_red}] »#{E:@catppuccin_ram_text} #[fg=#{@thm_crust},bg=#{@thm_peach}] »#{E:@catppuccin_uptime_text} #[fg=#{@thm_crust},bg=#{@thm_blue}] »#{E:@catppuccin_load_text} #[fg=#{@thm_crust},bg=#{@thm_sapphire}] » %Y-%m-%d %H:%M #[fg=#{@thm_fg},bg=default]"
{{- end }}

{{- if eq .chezmoi.os "windows" }}
set -g status-interval 60
{{- end }}

# Tmux Plugin Manager
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.idLike "debian") }}
run -b '/usr/share/tmux-plugin-manager/tpm'
{{- else }}
run -b '~/.tmux/plugins/tpm/tpm'
{{- end }}
