# Starship config — minimal cross-platform
# Windows 下 git.exe 偶发启动很慢（杀软/磁盘抖动），默认 command_timeout=500ms
# 会让 git_branch 报 timed out 并吞掉分支信息，这里放宽到 2s。
command_timeout = 2000
scan_timeout = 100
add_newline = false
format = "$directory$git_branch$git_status$character"

[directory]
truncation_length = 5
truncate_to_repo = true

[git_branch]
symbol = " "

[character]
success_symbol = "[❯](green)"
error_symbol = "[❯](red)"
