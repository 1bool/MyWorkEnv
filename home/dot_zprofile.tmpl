# MSYS2: zsh doesn't source /etc/profile — do it here
{{- if eq .chezmoi.os "windows" }}
emulate sh
. /etc/profile
emulate zsh
{{- end }}

# XDG_CONFIG_HOME / CLAUDE_CONFIG_DIR 由 .zshenv 统一设置（zsh 全场景加载）
# PATH 的增量统一在 ~/.config/shell/path.sh；这里 /etc/profile 会重置 PATH，所以再补一次
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh" ]; then
    . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/path.sh"
fi

EDITOR='nvim'

{{- if .isWSL }}
LANG=zh_CN.UTF-8
export DISPLAY=:0
{{- end }}

# load machine-specific env (bash/zsh 登录共用 ~/.profile.local)
if [ -f "$HOME/.profile.local" ]; then
    . "$HOME/.profile.local"
fi
