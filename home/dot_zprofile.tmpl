# MSYS2: zsh doesn't source /etc/profile — do it here
{{- if eq .chezmoi.os "windows" }}
emulate sh
. /etc/profile
emulate zsh
{{- end }}

{{- if eq .chezmoi.os "windows" }}
# chezmoi: isolate config per MSYS2 installation
export XDG_CONFIG_HOME="$(cygpath -m "$HOME/.config" 2>/dev/null || echo "$HOME/.config")"
# add Windows user bin for native exes (chezmoi etc.)
export PATH="$(cygpath -u "$USERPROFILE/.local/bin" 2>/dev/null || echo "$USERPROFILE/.local/bin"):$PATH"
	{{- if env "MSYSTEM" }}
	# add MSYS2 sbin for system daemons (e.g. unfsd)
	if [ -d "${MSYSTEM_PREFIX}/sbin" ]; then
		export PATH="${MSYSTEM_PREFIX}/sbin:$PATH"
	fi
	# Claude Code: use MSYS2 home for config
	export CLAUDE_CONFIG_DIR="$(cygpath -w "$HOME/.claude")"
	{{- end }}
{{- end }}

# set PATH to include user's private bin
if [ -d "$HOME/bin" ] ; then
    PATH="$HOME/bin:$PATH"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
    PATH="$HOME/.local/bin:$PATH"
fi

# opencode（AI coding agent）装到 ~/.opencode/bin
if [ -d "$HOME/.opencode/bin" ] ; then
    PATH="$HOME/.opencode/bin:$PATH"
fi

EDITOR='vim'

# Claude Code：模型映射（单一来源 ~/.config/shell/models.env）
# 隐私的 token/base_url 仍在 ~/.zprofile.local（不入库）
if [ -f "$HOME/.config/shell/models.env" ]; then
    . "$HOME/.config/shell/models.env"
fi

{{- if .isWSL }}
LANG=zh_CN.UTF-8
export DISPLAY=:0
{{- end }}

# load local customizations
if [ -f "$HOME/.zprofile.local" ]; then
    . "$HOME/.zprofile.local"
fi
