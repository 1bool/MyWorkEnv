{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "shell": "bash",
  // 双后端（token.molchip.com 网关 / DeepSeek 直连）统一走 Anthropic 协议，
  // 由 ~/.zshrc.local 的 ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY 环境变量驱动。
  // 模型单一来源：~/.profile.local 的 OP_*（由 AI_MODEL_FLASH/PRO 派生），此处只引用 env，
  // 与 Claude Code 的 ANTHROPIC_* 同源。默认/轻量(title)=flash，plan=pro，build=flash。
  "model": "{env:OP_MODEL}",
  "agents": {
    "plan": { "model": "{env:OP_PLAN}" },
    "build": { "model": "{env:OP_BUILD}" },
    "title": { "model": "{env:OP_TITLE}" }
  },
  "plugins": [
    {
      "package": "@plannotator/opencode@0.28.67",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": ["plan"]
      }
    }
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "kimi-k3": { "name": "Kimi K3" }
      }
    }
  }
}
