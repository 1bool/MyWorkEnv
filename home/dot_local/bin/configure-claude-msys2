#!/usr/bin/env bash
# configure-claude-msys2 — set Claude Code SHELL to MSYS2 wrapper
#
# Called from install.sh when MSYS2 is detected.
# Writes to MSYS2 $HOME/.claude/settings.json (isolated via CLAUDE_CONFIG_DIR).
set -euo pipefail

wrapper_path() {
    # Return Windows-style path to msys2-shell inside MSYS2 home
    cygpath -w "$HOME/.local/bin/msys2-shell"
}

SETTINGS_FILE="$HOME/.claude/settings.json"
WRAPPER="$(wrapper_path)"

mkdir -p "$HOME/.claude"

if [[ ! -f "$SETTINGS_FILE" ]]; then
    echo "Creating ${SETTINGS_FILE}..."
    cat > "$SETTINGS_FILE" <<EOF
{
  "env": {
    "SHELL": "${WRAPPER}"
  }
}
EOF
    echo "Done."
    exit 0
fi

# If SHELL already set, update it in place
if grep -q '"SHELL"' "$SETTINGS_FILE"; then
    echo "Updating SHELL in ${SETTINGS_FILE}..."
    sed -i "s|\"SHELL\": *\"[^\"]*\"|\"SHELL\": \"${WRAPPER}\"|" "$SETTINGS_FILE"
    echo "Done."
    exit 0
fi

# SHELL not set — insert after "env": { line, or add env block
echo "Adding SHELL to ${SETTINGS_FILE}..."
if grep -q '"env"' "$SETTINGS_FILE"; then
    sed -i "/\"env\"/,/\"}/{
        /\"env\".*/!{
            /}/i\\
    \"SHELL\": \"${WRAPPER}\"
        }
    }" "$SETTINGS_FILE"
else
    sed -i "/^{/a\\
  \"env\": {\\
    \"SHELL\": \"${WRAPPER}\"\\
  }," "$SETTINGS_FILE"
fi
echo "Done."
