{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "shell": "bash",
  // 双后端（token.molchip.com 网关 / DeepSeek 直连）统一走 Anthropic 协议，
  // 由 ~/.zshrc.local 的 ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY 环境变量驱动。
  // 主模型 OP_MODEL 用于日常对话/编码；辅模型 OP_SMALL_MODEL 仅在轻量任务
  // （标题/摘要/统计）自动调用以节省成本。kimi-k3 为最强档，/models 切换（仅后端 A）。
  "lsp": true,
  "permission": {
    "lsp": "allow"
  },
  "model": "{env:OP_MODEL}",
  "small_model": "{env:OP_SMALL_MODEL}",
  "plugin": [
    ["@plannotator/opencode@latest", {
      "workflow": "plan-agent",
      "planningAgents": ["plan"]
    }],
    "opencode-nvim-editor-context"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "{env:ANTHROPIC_BASE_URL}/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "kimi-k3": { "name": "Kimi K3" }
      }
    }
  }
}
