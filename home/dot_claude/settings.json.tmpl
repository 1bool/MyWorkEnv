{{- $msysRoot := trimSuffix "/etc/config.site" (env "CONFIG_SITE") -}}
{
{{- if and (eq .chezmoi.os "windows") (ne $msysRoot "") }}
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "{{ $msysRoot }}/usr/bin/bash.exe",
    "BASH_ENV": "~/.claude/bash_env"
  },
{{- else }}
  "env": {},
{{- end }}
  "enabledPlugins": {
    "plannotator@plannotator": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "autoCompactWindow": 800000,
  "theme": "auto"
}
